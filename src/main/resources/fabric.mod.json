{
  "schemaVersion": 1,
  "id": "cesium",
  "version": "${v_mod}",
  "name": "Cesium",
  "description": "An alternative storage format for Minecraft.",
  "authors": [
    "JellySquid",
    "Yamayaki"
  ],
  "contact": {
    "homepage": "https://github.com/CesiumMC",
    "sources": "https://github.com/CesiumMC/cesium-fabric"
  },
  "license": "LGPL-3.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "de.yamayaki.cesium.CesiumMod"
    ]
  },
  "mixins": ["cesium.mixins.json"],
  "accessWidener": "cesium/${aw_file}",
  "depends": {
    "fabricloader": ">=${v_fabric}",
    "minecraft": "${v_minecraft}"
  },
  "breaks": {
    "moonrise": "*",
    "c2me": "*"
  }
}
